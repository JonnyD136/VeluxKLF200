{
    "elements": [
        {
            "name": "NodeId",
            "type": "NumberSpinner",
            "caption": "Node ID"
        },
        {
            "name": "WaitForFinishSession",
            "type": "CheckBox",
            "caption": "Wait for the status of the device"
        },
        {
            "name": "AutoRename",
            "type": "CheckBox",
            "caption": "Rename the instance if the name changes in the KLF200"
        },
        {
            "type": "ExpansionPanel",
            "caption": "KNX (Rollladensteuerung per KNX-Taster)",
            "items": [
                {
                    "name": "KnxUpDownVarID",
                    "type": "SelectVariable",
                    "caption": "KNX Auf/Ab (DPT1: 0 = Auf, 1 = Ab)"
                },
                {
                    "name": "KnxStopVarID",
                    "type": "SelectVariable",
                    "caption": "KNX Stop (DPT1)"
                },
                {
                    "name": "KnxPositionVarID",
                    "type": "SelectVariable",
                    "caption": "KNX Position Steuerung (DPT5, 0-100 %)"
                },
                {
                    "name": "KnxPositionStatusVarID",
                    "type": "SelectVariable",
                    "caption": "KNX Position Status/Rückmeldung (DPT5, 0-100 %)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Request device state",
            "onClick": "KLF200_RequestStatus($id);"
        },
        {
            "type": "Button",
            "caption": "Request device information",
            "onClick": "KLF200_RequestNodeInformation($id);"
        },
        {
            "type": "TestCenter"
        }
    ]
}
